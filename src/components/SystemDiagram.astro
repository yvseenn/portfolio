---
interface Props {
  center: [string, string];
  nodes: string[];
  label: string;
}
const { center, nodes, label } = Astro.props;

const cx = 210;
const cy = 200;
const r = 142;
const placed = nodes.map((text, i) => {
  const angle = ((-90 + i * (360 / nodes.length)) * Math.PI) / 180;
  const width = Math.round(text.length * 7.3 + 28);
  return { text, width, x: cx + r * Math.cos(angle), y: cy + r * Math.sin(angle) };
});
---

<svg class="diagram" viewBox="0 0 420 400" role="img" aria-label={label}>
  <circle class="ring" cx={cx} cy={cy} r={r}></circle>
  {placed.map((n) => <line class="spoke" x1={cx} y1={cy} x2={n.x} y2={n.y} />)}
  <circle class="core" cx={cx} cy={cy} r="62"></circle>
  <text class="core-text" x={cx} y={cy - 4} text-anchor="middle">{center[0]}</text>
  <text class="core-text" x={cx} y={cy + 18} text-anchor="middle">{center[1]}</text>
  {
    placed.map((n) => (
      <g>
        <rect class="node" x={n.x - n.width / 2} y={n.y - 17} width={n.width} height="34" rx="17" />
        <text class="node-text" x={n.x} y={n.y + 4.5} text-anchor="middle">
          {n.text}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .diagram {
    width: 100%;
    max-width: 440px;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  .ring {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
    transform-origin: 210px 200px;
    animation: turn 90s linear infinite;
  }
  .spoke {
    stroke: var(--accent);
    stroke-width: 1.25;
    opacity: 0.55;
  }
  .core {
    fill: var(--accent);
  }
  .core-text {
    fill: var(--accent-ink);
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .node {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .node-text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
</style>
