---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import SystemDiagram from './SystemDiagram.astro';
import { links, name } from '../data/types';
import type { Content } from '../data/types';

interface Props {
  content: Content;
}
const { content: c } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const other = c.lang === 'es' ? `${base}/en/` : home;
const self = c.lang === 'es' ? home : `${base}/en/`;
const year = new Date().getFullYear();
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:locale" content={c.lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1012" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang={c.lang === 'es' ? 'en' : 'es'} href={other} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{c.nav.skip}</a>

    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={self}>{name}</a>
        <nav class="nav" aria-label={c.lang === 'es' ? 'Principal' : 'Main'}>
          <a class="nav-link" href="#work">{c.nav.work}</a>
          <a class="nav-link" href="#experience">{c.nav.experience}</a>
          <a class="nav-link" href="#contact">{c.nav.contact}</a>
          <a class="chip mono" href={other} hreflang={c.lang === 'es' ? 'en' : 'es'} aria-label={c.nav.switchTo}>
            {c.nav.switchLabel}
          </a>
          <button class="chip theme" type="button" id="theme-toggle" aria-label={c.nav.theme}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div class="hero-text">
          <p class="mono prompt"><span aria-hidden="true">~ $ whoami</span></p>
          <p class="role">{c.hero.role}</p>
          <h1>{c.hero.title}</h1>
          <p class="lead">{c.hero.lead}</p>
          <ul class="brands mono" aria-label={c.lang === 'es' ? 'Marcas del grupo' : 'Group brands'}>
            {c.hero.brands.map((b) => <li>{b}</li>)}
          </ul>
          <div class="actions">
            <a class="btn primary" href={`mailto:${links.email}`}>{c.hero.cta}</a>
            <a class="btn" href={links.linkedin} rel="noopener">LinkedIn</a>
            <a class="btn" href={links.github} rel="noopener">GitHub</a>
          </div>
        </div>
        <div class="hero-art">
          <SystemDiagram {...c.hero.diagram} />
        </div>
      </section>

      <section class="wrap">
        <dl class="stats">
          {
            c.stats.map((s) => (
              <div class="stat">
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="section wrap" id="work">
        <div class="section-head">
          <h2>{c.work.heading}</h2>
          <p>{c.work.intro}</p>
        </div>
        <ol class="areas">
          {
            c.work.areas.map((a, i) => (
              <li class="area">
                <span class="mono num">{pad(i)}</span>
                <h3>{a.title}</h3>
                <div class="area-body">
                  <p>{a.text}</p>
                  {a.built && (
                    <ul class="built" aria-label={c.work.builtLabel}>
                      {a.built.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                  {a.tags.length > 0 && (
                    <ul class="tags mono">
                      {a.tags.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <blockquote class="quote">
          <p>{c.work.quote}</p>
        </blockquote>
      </section>

      <section class="section wrap" id="experience">
        <div class="section-head">
          <h2>{c.experience.heading}</h2>
        </div>
        <ol class="jobs">
          {
            c.experience.jobs.map((j) => (
              <li class="job">
                <span class="mono date">{j.date}</span>
                <div>
                  <h3>
                    {j.role} <span class="where">· {j.where}</span>
                  </h3>
                  <p>{j.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="cols">
          <div>
            <h3 class="mono label">{c.experience.educationHeading}</h3>
            <ul class="plain">
              {
                c.experience.education.map((e) => (
                  <li>
                    <strong>{e.name}</strong>
                    <span>
                      {e.where} · {e.date}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="mono label">{c.experience.languagesHeading}</h3>
            <ul class="plain">
              <li>
                <strong>{c.experience.languages}</strong>
                <span>{c.experience.background}</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="mono label">{c.earlier.heading}</h3>
            <ul class="plain">
              <li>
                <span>{c.earlier.intro}</span>
              </li>
              {
                c.earlier.projects.map((p) => (
                  <li>
                    <a href={p.url} rel="noopener">
                      {p.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="section wrap contact" id="contact">
        <h2>{c.contact.heading}</h2>
        <p>{c.contact.text}</p>
        <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="actions">
          <a class="btn" href={links.linkedin} rel="noopener">LinkedIn</a>
          <a class="btn" href={links.github} rel="noopener">GitHub</a>
        </div>
      </section>
    </main>

    <footer class="wrap foot mono">
      <span>© {year} {name}</span>
      <a href={other} hreflang={c.lang === 'es' ? 'en' : 'es'}>{c.nav.switchTo}</a>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }
  .nav-link {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .chip {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .theme {
    padding: 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .prompt {
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .role {
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 0.9rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }
  .lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.1875rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .brands {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .brands li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9875rem;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .btn:hover {
    border-color: var(--ink);
  }
  .btn.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .stat {
    padding: 1.75rem 1.5rem 1.75rem 0;
  }
  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .stat dt {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .stat dd {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.45;
    max-width: 17rem;
  }

  .section {
    padding-block: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    font-weight: 600;
  }
  .section-head p {
    color: var(--muted);
    max-width: 30rem;
  }

  .area {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 0.5rem 1.5rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .areas .area:last-child {
    border-bottom: 1px solid var(--line);
  }
  .num {
    color: var(--accent);
    padding-top: 0.3rem;
  }
  .area h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .area-body p {
    color: var(--muted);
    text-wrap: pretty;
  }
  .built {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .built li {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-weight: 500;
    font-size: 0.9875rem;
    line-height: 1.35;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.9rem;
    color: var(--ink);
  }
  .tags li::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
    translate: 0 -1px;
  }

  .quote {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-left: clamp(1rem, 3vw, 1.75rem);
    border-left: 3px solid var(--accent);
  }
  .quote p {
    font-size: clamp(1.3rem, 2.8vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 44rem;
    text-wrap: balance;
  }

  .job {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .date {
    color: var(--muted);
    padding-top: 0.25rem;
  }
  .job h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .where {
    font-weight: 400;
    color: var(--muted);
  }
  .job p {
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-top: 2rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .label {
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .plain {
    display: grid;
    gap: 0.75rem;
    font-size: 0.9875rem;
  }
  .plain strong {
    display: block;
    font-weight: 600;
    line-height: 1.4;
  }
  .plain span {
    color: var(--muted);
  }

  .contact {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .contact > p {
    margin-top: 0.75rem;
    color: var(--muted);
    max-width: 32rem;
  }
  .mail {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 4.6vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }
  .mail:hover {
    color: var(--accent);
  }
  .contact .actions {
    margin-top: 1.5rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-art {
      max-width: 340px;
      width: 100%;
      margin-inline: auto;
    }
    .area {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .area-body {
      grid-column: 2;
    }
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .nav-link {
      display: none;
    }
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .stat,
    .stat + .stat {
      padding: 1.1rem 0;
      border-left: 0;
    }
    .stat + .stat {
      border-top: 1px solid var(--line);
    }
    .stat dd {
      max-width: none;
    }
    .job {
      grid-template-columns: minmax(0, 1fr);
    }
    .built {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
